{
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "code-runner.runOnSave": false,
    "runOnSave.onlyRunOnManualSave": true,
    "runOnSave.commands": [
        {
            "languages": [
                "python"
            ],
            "notMatch": "[\\\\/]challenges[\\\\/]05_data_science[\\\\/](?:day_4[\\\\/]day_4|day_7[\\\\/]day_7|day_10[\\\\/]day_10)\\.py$",
            "command": "python -u ${file}",
            "runIn": "terminal"
        },
        {
            "languages": [
                "python"
            ],
            "match": "[\\\\/]challenges[\\\\/]05_data_science[\\\\/](?:day_4[\\\\/]day_4|day_7[\\\\/]day_7|day_10[\\\\/]day_10)\\.py$",
            "command": "workbench.action.tasks.build",
            "runIn": "vscode"
        }
    ],
    "workbench.editorAssociations": {
        "*.csv": "default",
        "*.xlsx": "spreadjs.designer"
    },
    "git.decorations.enabled": true,
    "explorer.decorations.colors": true,
    "workbench.colorCustomizations": {
        "gitDecoration.ignoredResourceForeground": "#808080"
    }
}
